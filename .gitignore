# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env
.env.*
!.env.example
**/.env
**/.env.local

# Secrets / local credentials
*.pem
*.key
credentials.json
secrets.json

# Build / dist (PyInstaller, Flutter)
build/
dist/
*.spec.bak

# Local Flutter SDK / caches (never bundle or commit)
.tools/

# Generated / working outputs
filled/
*.pdf
!mobile/**/*.pdf
_preview_*.png
_excel_preview.*
_flag_test.pdf
_logo_*.png
_extracted_*.png
_template_*.png
_tmp_*.png
_tmp_*.py
_tmp_*.pyc

# Local presets may contain customer data — keep sample-free copy optional
# presets.json is small defaults; commit OK. Uncomment to keep local-only:
# presets.json

# Runtime AppStorage (documents dir can be the repo folder on this machine)
remembered_contacts.json
settings.json
update_schedule.json
signatures.json
data_epoch.json

# Retired Fly.io restore-logo app — OneDrive sometimes restores these; never deploy.
services/restore-logo/Dockerfile
services/restore-logo/fly.toml
services/restore-logo/main.py
services/restore-logo/.dockerignore

# OneDrive / Windows junk
desktop.ini
Thumbs.db
~$*
*.tmp
.DS_Store

# Calibri is Microsoft-proprietary — keep local (copy via scripts/sync_calibri_fonts.ps1).
# Oswald (SIL OFL) is committed under fonts/ and mobile/assets/fonts/.
fonts/Calibri.ttf
fonts/Calibri-Bold.ttf
mobile/assets/fonts/Calibri.ttf
mobile/assets/fonts/Calibri-Bold.ttf

# IDE / tooling
.idea/
.vscode/
*.iml
.cursor/

# QA / restore scratch (do not commit customer logo batches)
qa_logs/
.cache/
customer_logos/gemini_restored/
customer_logos/restored_batch/
customer_logos/*_restored.png
customer_logos/*_restored.json
signatures/
changelog_prompt.json
__pycache__/
**/__pycache__/
scripts/__pycache__/

# Flutter (mobile/)
mobile/.dart_tool/
mobile/.flutter-plugins-dependencies
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/coverage/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/**/GeneratedPluginRegistrant.*

# Large accidental dumps
*.apk
*.aab
*.zip
!scripts/**/*.zip

# Bulk label smoke artifacts (regenerated by tests)
mobile/test/fixtures/_bulk_labels_smoke.pdf
mobile/test/fixtures/_bulk_labels_smoke.docx

# Claude Code local settings (machine-specific paths/permissions)
.claude/settings.local.json
